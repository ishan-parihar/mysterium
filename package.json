{
  "name": "mysterium",
  "version": "0.1.0",
  "description": "Mysterium — a gamified developmental assessment engine",
  "type": "module",
  "bin": {
    "mysterium": "./dist/cli/cli-game.js"
  },
  "files": [
    "dist/cli/",
    "src/core/data/",
    "src/core/world/data/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite dev",
    "arch:fixtures": "python3 scripts/arch.py fixtures",
    "arch:validate": "python3 scripts/arch.py validate",
    "bench:validation": "tsx scripts/run-validation-benchmark.ts --tier=full",
    "build": "npm run check:invariants && svelte-kit sync && tsc --noEmit && vite build",
    "build:cli": "svelte-kit sync && tsup",
    "build:preview": "node scripts/build-preview.mjs",
    "cap:android": "npm run build && cap sync android && cap open android",
    "cap:sync": "npm run build && cap sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:invariants": "npx tsx scripts/check-invariants.ts",
    "cli": "svelte-kit sync && tsx scripts/cli-game.ts",
    "cli:bundle": "node dist/cli/cli-game.js",
    "cohort": "npx tsx scripts/cohort-run.ts",
    "corpus:build": "npx tsx scripts/build-concept-index.ts",
    "facets:compile": "npx tsx scripts/compile-facets.ts",
    "personalization:calibrate": "npx tsx scripts/calibrate-personalization.ts",
    "prepublishOnly": "npm run verify:release",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:cli": "vitest run tests/cli",
    "test:watch": "vitest",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "verify:release": "npm run build && npm run build:cli && tsx scripts/verify-release.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor/preferences": "^6.0.2",
    "@clack/prompts": "^1.6.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-cloudflare": "^5.1.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@vite-pwa/sveltekit": "^1.1.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.6",
    "tsup": "^8.5.1",
    "tsx": "^4.22.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.10",
    "vite-pwa": "^1.0.2",
    "vitest": "^2.1.4",
    "wrangler": "^4.143.1"
  }
}
