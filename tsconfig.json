{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false
    // NOTE: baseUrl and paths are managed by SvelteKit via .svelte-kit/tsconfig.json
    // (generated from svelte.config.js kit.alias). Do NOT add them here —
    // SvelteKit warns about conflicts. Aliases (@core, @infra, $core,
    // $infra, $shared, $lib) are all in svelte.config.js kit.alias.
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    ".svelte-kit/ambient.d.ts",
    ".svelte-kit/non-ambient.d.ts",
    ".svelte-kit/types/**/$types.d.ts"
  ],
  "exclude": ["node_modules", "dist", "android", ".svelte-kit/build"]
}
